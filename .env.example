# --- App ---
# Runtime environment: development, test, or production.
NODE_ENV=development
# Product name shown in page metadata and the landing page.
APP_NAME=Cordly
# Public base URL used when generating absolute links.
APP_URL=http://localhost:3000

# --- MongoDB ---
# Paste your MongoDB connection string here. Example:
# mongodb://127.0.0.1:27017/cordly
# mongodb+srv://<username>:<password>@<cluster-host>/cordly?retryWrites=true&w=majority
MONGO_URL=
# Optional local Docker MongoDB root username (only needed for docker compose).
MONGO_ROOT_USERNAME=
# Optional local Docker MongoDB root password (only needed for docker compose).
MONGO_ROOT_PASSWORD=
# Maximum number of pooled MongoDB connections.
MONGODB_MAX_POOL_SIZE=20
# Minimum number of pooled MongoDB connections.
MONGODB_MIN_POOL_SIZE=2
# --- Auth / Security ---
# Long random secret (generate with: openssl rand -base64 48).
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
# Maximum lifetime of a login session, in days.
SESSION_MAX_AGE_DAYS=30
# Work factor used by bcrypt for account password hashing.
BCRYPT_ROUNDS=12

# --- Staff bootstrap ---
# The first account registered with this email becomes platform Owner. Empty disables bootstrap.
INITIAL_OWNER_EMAIL=

# --- Email (optional in development; unset values use console logging) ---
# SMTP server hostname.
SMTP_HOST=
# SMTP server port.
SMTP_PORT=587
# SMTP login username.
SMTP_USER=
# SMTP login password.
SMTP_PASS=
# Sender address used for outbound email.
EMAIL_FROM=

# --- Uploads ---
# Local upload directory.
UPLOAD_DIR=./uploads
# Maximum upload size in megabytes.
MAX_UPLOAD_MB=25

# --- Rate limiting ---
# Rate-limit window duration in seconds.
RATE_LIMIT_WINDOW_SECONDS=60
# Maximum requests allowed per client during the window.
RATE_LIMIT_MAX_REQUESTS=100
