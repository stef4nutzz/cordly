{
  "name": "discordv2",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "predev": "tsx src/scripts/validate-env.ts",
    "dev": "npm run build:server && node .next/cordly-server.cjs --dev",
    "prebuild": "tsx src/scripts/validate-env.ts",
    "build": "next build && npm run build:server",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --target=node20 --packages=external --outfile=.next/cordly-server.cjs",
    "prestart": "tsx src/scripts/validate-env.ts",
    "start": "node .next/cordly-server.cjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:init": "tsx src/scripts/db-init.ts",
    "db:status": "tsx src/scripts/db-status.ts",
    "db:reset": "tsx src/scripts/db-reset.ts",
    "staff:promote": "tsx src/scripts/staff-promote.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.6.1",
    "lucide-react": "^1.55.0",
    "mongoose": "^8.19.1",
    "next": "^16.4.0",
    "otpauth": "^9.5.2",
    "pino": "^9.14.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.4.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
